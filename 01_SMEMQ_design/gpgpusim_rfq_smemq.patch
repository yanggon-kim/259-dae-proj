+unsigned shader_core_config::wasp_rfq_regs_per_cta(
+    const kernel_info_t &k) const {
+  if (!(gpgpu_wasp_enable && gpgpu_wasp_rfq_enable &&
+        gpgpu_wasp_rfq_count_register_pressure))
+    return 0;
+  return wasp_rfq_producer_warps_per_cta(k) *
+         wasp_rfq_queues_per_original_warp() * gpgpu_wasp_rfq_entries *
+         wasp_rfq_payload_words_per_lane() * warp_size;
+}
+
+unsigned shader_core_config::wasp_rfq_producer_warps_per_cta(
+    const kernel_info_t &k) const {
+  unsigned threads_per_cta = k.threads_per_cta();
+  unsigned int padded_cta_size = threads_per_cta;
+  if (padded_cta_size % warp_size)
+    padded_cta_size = ((padded_cta_size / warp_size) + 1) * warp_size;
+  unsigned warps_per_cta = padded_cta_size / warp_size;
+  if (wasp_metadata_producer_warps_per_cta > 0) {
+    assert(wasp_metadata_producer_warps_per_cta < warps_per_cta);
+    return wasp_metadata_producer_warps_per_cta;
+  }
+  unsigned producer_warps_per_cta = warps_per_cta / 2;
+  return producer_warps_per_cta ? producer_warps_per_cta : 1;
+}
