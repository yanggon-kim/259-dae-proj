+
+void shader_core_ctx::smemq_prepare_issue(warp_inst_t *inst) {
+  if (!smemq_enabled() || !inst || !(inst->m_smemq_load || inst->m_smemq_move))
+    return;
+
+  smemq_key key = smemq_key_for_warp(inst->warp_id(), inst->m_smemq_queue_id);
+  unsigned payload_words =
+      inst->m_smemq_payload_words_per_lane
+          ? inst->m_smemq_payload_words_per_lane
+          : 1;
+  smemq &queue = m_smemq_table.get_or_create(
+      key, m_config->gpgpu_smemq_entries, payload_words, m_config->warp_size);
+
+  if (inst->m_smemq_load) {
+    assert(!queue.full());
+    smemq_token token = queue.reserve_tail(key, inst->get_active_mask(), 0);
+    smemq_write_token_to_inst(inst, token);
+    m_stats->smemq_reservations++;
+    if (queue.occupancy() > m_stats->smemq_max_occupancy)
+      m_stats->smemq_max_occupancy = queue.occupancy();
+  } else {
+    smemq_token token;
+    token.key = key;
+    token.payload_words_per_lane = payload_words;
+    token.valid = true;
+    smemq_write_token_to_inst(inst, token);
+  }
+}
+
+void shader_core_ctx::smemq_after_func_exec(warp_inst_t *inst) {
+  if (!smemq_enabled() || !inst || !(inst->m_smemq_load || inst->m_smemq_move))
+    return;
+
+  smemq_token token = smemq_token_from_inst(*inst);
+  smemq *queue = m_smemq_table.find(token.key);
+  assert(queue);
+
+  if (inst->m_smemq_load) {
+    queue->set_pending_responses(token, inst->accessq_count());
+  } else {
+    assert(queue->head_ready());
+    queue->consume_head(token.key);
+    m_stats->smemq_consumes++;
+  }
+}
+
+bool shader_core_ctx::smemq_load_pending(const warp_inst_t &inst) const {
+  if (!smemq_enabled() || !inst.m_smemq_load) return false;
+  smemq_token token = smemq_token_from_inst(inst);
+  const smemq *queue = m_smemq_table.find(token.key);
+  assert(queue);
+  return queue->has_pending_responses(token);
+}
+
+bool shader_core_ctx::smemq_mark_mem_response(const warp_inst_t &inst) {
+  if (!smemq_enabled() || !inst.m_smemq_load) return true;
+  smemq_token token = smemq_token_from_inst(inst);
+  smemq *queue = m_smemq_table.find(token.key);
+  assert(queue);
+  m_stats->smemq_memory_fills++;
+  return queue->mark_response(token);
+}
+
+void shader_core_ctx::smemq_functional_store_lane(const warp_inst_t &inst,
+                                                  unsigned lane_id,
+                                                  unsigned word,
+                                                  uint64_t value) {
+  if (!smemq_enabled() || !m_config->gpgpu_smemq_model_data) return;
+  smemq_token token = smemq_token_from_inst(inst);
+  smemq *queue = m_smemq_table.find(token.key);
+  assert(queue);
+  queue->set_lane_value(token, lane_id, word, value);
+}
+
+uint64_t shader_core_ctx::smemq_functional_read_lane(
+    const warp_inst_t &inst, unsigned lane_id, unsigned word) const {
+  if (!smemq_enabled() || !m_config->gpgpu_smemq_model_data) return 0;
+  smemq_token token = smemq_token_from_inst(inst);
+  const smemq *queue = m_smemq_table.find(token.key);
+  assert(queue);
+  return queue->head_lane_value(lane_id, word);
+}
