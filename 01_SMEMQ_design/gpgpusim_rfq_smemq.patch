+uint64_t shader_core_ctx::wasp_rfq_functional_read_lane(
+    const warp_inst_t &inst, unsigned lane_id, unsigned word) const {
+  if (!wasp_rfq_enabled() || !m_config->gpgpu_wasp_rfq_model_data) return 0;
+  wasp_rfq_token token = wasp_rfq_token_from_inst(inst);
+  const wasp_rfq *queue = m_wasp_rfq_table.find(token.key);
