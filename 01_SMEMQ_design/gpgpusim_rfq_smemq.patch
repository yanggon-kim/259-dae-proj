+static addr_t wasp_rfq_effective_address(const ptx_instruction *pI,
+                                         ptx_thread_info *thread,
+                                         const operand_info &src) {
+  ptx_reg_t addr_reg =
+      thread->get_operand_value(src, src, pI->get_type(), thread, 0);
+  addr_t addr = addr_reg.u64;
+  memory_space_t space = pI->get_space();
+  if (space.get_type() == generic_space) {
+    space = whichspace(addr);
+    if (space.get_type() == global_space) addr = generic_to_global(addr);
+  }
+  assert(space.get_type() == global_space);
+  return addr;
+}
+
+static void wasp_rfq_ld_exec(const ptx_instruction *pI,
+                             ptx_thread_info *thread, warp_inst_t &inst,
+                             unsigned lane_id) {
+  shader_core_ctx *shader = static_cast<shader_core_ctx *>(thread->get_core());
+  unsigned payload_words = inst.m_wasp_rfq_payload_words_per_lane;
+  if (payload_words == 0) payload_words = 1;
+  assert(payload_words <= MAX_ACCESSES_PER_INSN_PER_THREAD);
+  assert(pI->get_num_operands() >= payload_words + 1);
+
+  size_t size;
+  int basic_type;
+  type_info_key::type_decode(pI->get_type(), size, basic_type);
+  new_addr_type addrs[MAX_ACCESSES_PER_INSN_PER_THREAD];
+
+  for (unsigned word = 0; word < payload_words; ++word) {
+    const operand_info &src = pI->operand_lookup(word + 1);
+    addr_t addr = wasp_rfq_effective_address(pI, thread, src);
+    ptx_reg_t data;
+    data.u64 = 0;
+    thread->get_global_memory()->read(addr, size / 8, &data.s64);
+    shader->wasp_rfq_functional_store_lane(inst, lane_id, word, data.u64);
+    addrs[word] = addr;
+  }
+  inst.set_addr(lane_id, addrs, payload_words);
+}
+
+static void wasp_rfq_mov_exec(const ptx_instruction *pI,
+                              ptx_thread_info *thread, warp_inst_t &inst,
+                              unsigned lane_id) {
+  shader_core_ctx *shader = static_cast<shader_core_ctx *>(thread->get_core());
+  unsigned payload_words = inst.m_wasp_rfq_payload_words_per_lane;
+  if (payload_words == 0) payload_words = 1;
+  assert(payload_words <= 4);
+
+  ptx_reg_t values[4];
+  for (unsigned word = 0; word < 4; ++word) values[word].u64 = 0;
+  for (unsigned word = 0; word < payload_words; ++word) {
+    values[word].u64 =
+        shader->wasp_rfq_functional_read_lane(inst, lane_id, word);
+  }
+
+  const operand_info &dst = pI->dst();
+  if (dst.is_vector()) {
+    thread->set_vector_operand_values(dst, values[0], values[1], values[2],
+                                      values[3]);
+  } else {
+    thread->set_operand_value(dst, values[0], pI->get_type(), thread, pI);
+  }
+}
+
+static void smemq_ld_exec(const ptx_instruction *pI, ptx_thread_info *thread,
+                          warp_inst_t &inst, unsigned lane_id) {
+  shader_core_ctx *shader = static_cast<shader_core_ctx *>(thread->get_core());
+  unsigned payload_words = inst.m_smemq_payload_words_per_lane;
+  if (payload_words == 0) payload_words = 1;
+  assert(payload_words <= MAX_ACCESSES_PER_INSN_PER_THREAD);
+  assert(pI->get_num_operands() >= payload_words + 1);
+
+  size_t size;
+  int basic_type;
+  type_info_key::type_decode(pI->get_type(), size, basic_type);
+  new_addr_type addrs[MAX_ACCESSES_PER_INSN_PER_THREAD];
+
+  for (unsigned word = 0; word < payload_words; ++word) {
+    const operand_info &src = pI->operand_lookup(word + 1);
+    addr_t addr = wasp_rfq_effective_address(pI, thread, src);
+    ptx_reg_t data;
+    data.u64 = 0;
+    thread->get_global_memory()->read(addr, size / 8, &data.s64);
+    shader->smemq_functional_store_lane(inst, lane_id, word, data.u64);
+    addrs[word] = addr;
+  }
+  inst.set_addr(lane_id, addrs, payload_words);
+}
+
+static void smemq_mov_exec(const ptx_instruction *pI, ptx_thread_info *thread,
+                           warp_inst_t &inst, unsigned lane_id) {
+  shader_core_ctx *shader = static_cast<shader_core_ctx *>(thread->get_core());
+  unsigned payload_words = inst.m_smemq_payload_words_per_lane;
+  if (payload_words == 0) payload_words = 1;
+  assert(payload_words <= 4);
+
+  ptx_reg_t values[4];
+  for (unsigned word = 0; word < 4; ++word) values[word].u64 = 0;
+  for (unsigned word = 0; word < payload_words; ++word) {
+    values[word].u64 = shader->smemq_functional_read_lane(inst, lane_id, word);
+  }
+
+  const operand_info &dst = pI->dst();
+  if (dst.is_vector()) {
+    thread->set_vector_operand_values(dst, values[0], values[1], values[2],
+                                      values[3]);
+  } else {
+    thread->set_operand_value(dst, values[0], pI->get_type(), thread, pI);
+  }
+}
