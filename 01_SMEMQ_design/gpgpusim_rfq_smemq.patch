+bool shader_core_ctx::wasp_rfq_enabled() const {
+  return m_config->gpgpu_wasp_enable && m_config->gpgpu_wasp_rfq_enable;
+}
+
+wasp_rfq_key shader_core_ctx::wasp_rfq_key_for_warp(
+    unsigned warp_id, unsigned queue_id) const {
+  assert(warp_id < m_warp.size());
+  unsigned warps_per_cta = kernel_padded_threads_per_cta / m_config->warp_size;
+  if (warps_per_cta == 0) warps_per_cta = 8;
+  unsigned local_warp = warp_id % warps_per_cta;
+  unsigned producer_warps = m_config->wasp_metadata_producer_warps_per_cta
+                                ? m_config->wasp_metadata_producer_warps_per_cta
+                                : warps_per_cta / 2;
+  if (producer_warps == 0) producer_warps = 1;
+  assert(producer_warps < warps_per_cta);
+  unsigned original_warp_id =
+      local_warp < producer_warps ? local_warp : local_warp - producer_warps;
+
+  wasp_rfq_key key;
+  key.cta_hw_id = m_warp[warp_id]->get_cta_id();
+  key.original_warp_id = original_warp_id;
+  key.src_stage_id = 0;
+  key.dst_stage_id = 1;
+  key.queue_id = queue_id;
+  return key;
+}
+
+wasp_rfq_token shader_core_ctx::wasp_rfq_token_from_inst(
+    const warp_inst_t &inst) const {
+  wasp_rfq_token token;
+  token.key.cta_hw_id = inst.m_wasp_rfq_token_cta_hw_id;
+  token.key.original_warp_id = inst.m_wasp_rfq_token_original_warp_id;
+  token.key.src_stage_id = 0;
+  token.key.dst_stage_id = 1;
+  token.key.queue_id = inst.m_wasp_rfq_queue_id;
+  token.slot_index = inst.m_wasp_rfq_token_slot_index;
+  token.sequence = inst.m_wasp_rfq_token_sequence;
+  token.payload_words_per_lane = inst.m_wasp_rfq_payload_words_per_lane;
+  token.valid = inst.m_wasp_rfq_token_valid;
+  return token;
+}
+
+void shader_core_ctx::wasp_rfq_write_token_to_inst(
+    warp_inst_t *inst, const wasp_rfq_token &token) {
+  inst->m_wasp_rfq_token_valid = token.valid;
+  inst->m_wasp_rfq_token_cta_hw_id = token.key.cta_hw_id;
+  inst->m_wasp_rfq_token_original_warp_id = token.key.original_warp_id;
+  inst->m_wasp_rfq_token_slot_index = token.slot_index;
+  inst->m_wasp_rfq_token_sequence = token.sequence;
+}
+
+bool shader_core_ctx::wasp_rfq_can_issue(unsigned warp_id,
+                                         const warp_inst_t *inst,
+                                         bool count_stall) {
+  if (!inst || !(inst->m_wasp_rfq_load || inst->m_wasp_rfq_move)) return true;
+  if (!wasp_rfq_enabled()) {
+    printf("GPGPU-Sim WASP RFQ: RFQ PTX requires RFQ config to be enabled\n");
+    abort();
+  }
+
+  wasp_rfq_key key = wasp_rfq_key_for_warp(warp_id, inst->m_wasp_rfq_queue_id);
+  unsigned payload_words =
+      inst->m_wasp_rfq_payload_words_per_lane
+          ? inst->m_wasp_rfq_payload_words_per_lane
+          : 1;
+  wasp_rfq &queue = m_wasp_rfq_table.get_or_create(
+      key, m_config->gpgpu_wasp_rfq_entries, payload_words,
+      m_config->warp_size);
+
+  if (inst->m_wasp_rfq_load) {
+    if (queue.full()) {
+      if (count_stall) m_stats->wasp_rfq_full_stalls++;
+      return false;
+    }
+    return true;
+  }
+
+  if (queue.empty()) {
+    if (count_stall) m_stats->wasp_rfq_empty_stalls++;
+    return false;
+  }
+  if (!queue.head_ready()) {
+    if (count_stall) m_stats->wasp_rfq_head_not_ready_stalls++;
+    return false;
+  }
+  return true;
+}
+
+void shader_core_ctx::wasp_rfq_prepare_issue(warp_inst_t *inst) {
+  if (!wasp_rfq_enabled() || !inst ||
+      !(inst->m_wasp_rfq_load || inst->m_wasp_rfq_move))
+    return;
+
+  wasp_rfq_key key =
+      wasp_rfq_key_for_warp(inst->warp_id(), inst->m_wasp_rfq_queue_id);
+  unsigned payload_words =
+      inst->m_wasp_rfq_payload_words_per_lane
+          ? inst->m_wasp_rfq_payload_words_per_lane
+          : 1;
+  wasp_rfq &queue = m_wasp_rfq_table.get_or_create(
+      key, m_config->gpgpu_wasp_rfq_entries, payload_words,
+      m_config->warp_size);
+
+  if (inst->m_wasp_rfq_load) {
+    assert(!queue.full());
+    wasp_rfq_token token =
+        queue.reserve_tail(key, inst->get_active_mask(), 0);
+    wasp_rfq_write_token_to_inst(inst, token);
+    m_stats->wasp_rfq_reservations++;
+    if (queue.occupancy() > m_stats->wasp_rfq_max_occupancy)
+      m_stats->wasp_rfq_max_occupancy = queue.occupancy();
+    m_stats->wasp_stage_issue_count[0]++;
+  } else {
+    wasp_rfq_token token;
+    token.key = key;
+    token.payload_words_per_lane = payload_words;
+    token.valid = true;
+    wasp_rfq_write_token_to_inst(inst, token);
+    m_stats->wasp_stage_issue_count[1]++;
+  }
+}
+
+void shader_core_ctx::wasp_rfq_after_func_exec(warp_inst_t *inst) {
+  if (!wasp_rfq_enabled() || !inst ||
+      !(inst->m_wasp_rfq_load || inst->m_wasp_rfq_move))
+    return;
+
+  wasp_rfq_token token = wasp_rfq_token_from_inst(*inst);
+  wasp_rfq *queue = m_wasp_rfq_table.find(token.key);
+  assert(queue);
+
+  if (inst->m_wasp_rfq_load) {
+    queue->set_pending_responses(token, inst->accessq_count());
+  } else {
+    assert(queue->head_ready());
+    queue->consume_head(token.key);
+    m_stats->wasp_rfq_consumes++;
+  }
+}
+
+bool shader_core_ctx::wasp_rfq_load_pending(const warp_inst_t &inst) const {
+  if (!wasp_rfq_enabled() || !inst.m_wasp_rfq_load) return false;
+  wasp_rfq_token token = wasp_rfq_token_from_inst(inst);
+  const wasp_rfq *queue = m_wasp_rfq_table.find(token.key);
+  assert(queue);
+  return queue->has_pending_responses(token);
+}
+
+bool shader_core_ctx::wasp_rfq_mark_mem_response(const warp_inst_t &inst) {
+  if (!wasp_rfq_enabled() || !inst.m_wasp_rfq_load) return true;
+  wasp_rfq_token token = wasp_rfq_token_from_inst(inst);
+  wasp_rfq *queue = m_wasp_rfq_table.find(token.key);
+  assert(queue);
+  m_stats->wasp_rfq_memory_fills++;
+  return queue->mark_response(token);
+}
