# H200-like GPGPU-Sim 132-SM variant with MSHR=512 (action-plan step 3-2)
#
# === 2026-05-24 REAL-HOPPER FIDELITY UPGRADE ===
# Function-unit initiation intervals corrected from inherited Volta values to
# real Hopper (H100/H200): FP32 II 2->1 (Hopper full-rate, 128 FP32/SM), and
# FP64 II 4->2 (datacenter 1/2-rate, 64 FP64/SM). INT/SFU were already correct.
# This dir is the real-H200-faithful reference config. Full rationale + per-knob
# real-H200 mapping in: H200_config_fidelity.md (this directory).
# NOTE: dual-issue tuning is a SEPARATE axis — see 01_doc/02_config_recommendations/dual_issue_config_recommendations.md.
#
# Authored from 01_after_v3_run.md §Action plan step 3-2 and
# 04_step3_1_vs_reference.md §Recommended next step. Sibling to
# config_h200_132sm/ (step 3-1 baseline).
#
# Change from config_h200_132sm/: only -gpgpu_cache:dl1 MSHR entries 256 → 512.
# All other knobs inherited verbatim — 132 SMs, 24 channels, v3 address mapping.
#
# Per-SM ratios match real H200 (same as step 3-1):
#   BW/SM:        4800 GB/s / 132 SMs   = 36.4 GB/s/SM   (real H200: 36.4)
#   L2/SM:        50.33 MB / 132 SMs    = 0.38 MB/SM     (real H200: 0.38)
#   HBM chan/SM:  24 / 132               = 0.18           (real H200: 0.18)
#
# Hypothesis being tested (per 04_step3_1_vs_reference.md):
#   Step 3-1 shows high L1 hit (88%) / low L2 hit (6%) on cant — sim is
#   MSHR-bottlenecked (17M reservation fails on cant) rather than latency-bound.
#   Raising MSHR from 256 to 512 should let more concurrent loads progress,
#   exposing the DRAM latency that real H200 actually sees, and thereby:
#     - reducing MSHR reservation fails
#     - possibly raising DRAM bw_util closer to real H200's 25%+ band
#     - shifting W0_Scoreboard fraction toward the real H200 37% range
#
# Policy (unchanged from v3):
#   - keep Volta ISA / sm_70 (compute cap 7.0)
#   - power-of-two L2 set count
#   - Hopper-sized shared memory (228 KB/SM, 227 KB/CTA)
#   - no Hopper ISA features

# functional simulator specification
-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 70

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
-gpgpu_kernel_launch_latency 5000
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128

# Compute Capability (v3: keep 7.0 for PTX compatibility; Hopper ISA out of scope)
-gpgpu_compute_capability_major 7
-gpgpu_compute_capability_minor 0

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# high-level architecture
# 132 SMs = real H200 SM count. Keeps v3's 24 HBM channels, 50 MB L2, 4.8 TB/s.
# Per-SM ratios (BW/L2/channels) now match real H200 by construction.
-gpgpu_n_clusters 132
-gpgpu_n_cores_per_cluster 1
-gpgpu_n_mem 24
-gpgpu_n_sub_partition_per_mchannel 2
-gpgpu_clock_gated_lanes 1

# clocks — v3: 1980 MHz core, 3125 MHz DRAM (DDR ratio 2 → 6250 MT/s effective)
# Sanity: 24 × 32 B × 2 × 3125 MHz / 1000 = 4800 GB/s ✓
-gpgpu_clock_domains 1980.0:1980.0:1980.0:3125.0

# shader / occupancy model — Volta-shaped per v3
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 70
-gpgpu_shader_core_pipeline 2048:32
-gpgpu_shader_cta 32
-gpgpu_simd_model 1

# Pipeline widths and FU counts (Volta — kept per v3 "no µarch change" rule)
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4

# Instruction latencies (kept at Volta values; per-op latency ~unchanged on Hopper)
-ptx_opcode_latency_int 4,13,4,5,145,21
# INT32: Hopper 64/SM = 16/subpart -> II=2 (already correct; same as Volta)
-ptx_opcode_initiation_int 2,2,2,2,8,4
-ptx_opcode_latency_fp 4,13,4,5,39
# FP32: Hopper 128/SM = 32/subpart -> full-rate -> II=1 (2026-05-24 fidelity fix; was Volta's 2).
# Matches GPGPU-Sim's shipped Ampere SM86 config (init_fp=1). See H200_config_fidelity.md.
-ptx_opcode_initiation_fp 1,1,1,1,4
-ptx_opcode_latency_dp 8,19,8,8,330
# FP64: H100/H200 datacenter 64/SM = 16/subpart = 1/2 FP32 rate -> II=2 (2026-05-24 fidelity fix; was Volta's 4).
-ptx_opcode_initiation_dp 2,2,2,2,130
-ptx_opcode_latency_sfu 100
# SFU: Hopper 16/SM = 4/subpart -> II=8 (already correct)
-ptx_opcode_initiation_sfu 8
-ptx_opcode_latency_tesnor 64
-ptx_opcode_initiation_tensor 64

# Sub core model (same as Volta)
-gpgpu_sub_core_model 1
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 8
-gpgpu_operand_collector_num_in_ports_gen 8
-gpgpu_operand_collector_num_out_ports_gen 8
-gpgpu_num_reg_banks 16
-gpgpu_reg_file_port_throughput 2

# shared memory bankconflict detection
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 70

# 4 schedulers per core (unchanged Volta→Hopper)
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler lrr
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

## L1 / shared-memory configuration — v3 Hopper sizes
# Unified L1+shmem+texture pool = 256 KB per SM (up from B200 192).
# Base L1 geometry 32 KB (4 × 128 × 64); adaptive resizing scales associativity
# based on the chosen shmem carveout (see v3 §7.1 for the 228 KB → 28 KB L1 derivation).
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,100,132,164,196,228
-gpgpu_unified_l1d_size 256
-gpgpu_l1_banks 4
# 2026-06-02 H200 memory-fidelity (Tier 1): L1 miss-queue 64->256 so the L1 can
# hold enough outstanding misses to sustain HBM3e bandwidth (bandwidth-delay
# product). MSHR kept at 512 (this config is deliberately mshr512; real Hopper
# L1 MSHR depth is unpublished). See H200_config_fidelity.md.
-gpgpu_cache:dl1 S:4:128:64,L:T:m:L:L,A:512:8,256:0,32
-gpgpu_l1_cache_write_ratio 25
-gpgpu_l1_latency 20
-gpgpu_gmem_skip_L1D 0
-gpgpu_flush_l1_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32

# Shared memory — v3: 228 KB/SM, 227 KB/CTA (Hopper maxima)
-gpgpu_shmem_size 233472
-gpgpu_shmem_sizeDefault 233472
-gpgpu_shmem_per_block 232448
-gpgpu_smem_latency 20

# L2 cache — v3: 256 sets × 128 B × 32 ways × 48 sub-partitions = 50.33 MB
# Power-of-two set count is REQUIRED by gpu-cache.cc:122,128,138 ((nset-1) bitmask).
# v3-fixup: set-index function changed from 'P' (IPOLY) to 'L' (LINEAR). IPOLY
# hash in hashing.cc:38-96 ONLY implements 16/32/64 bank/set counts — asserts otherwise.
# B200's S:32 worked with 'P' because 32 is on that whitelist; 256 is not.
-gpgpu_cache:dl2 S:256:128:32,L:B:m:L:L,A:192:4,32:0,32
-gpgpu_cache:dl2_texture_only 0
# 2026-06-02 H200 memory-fidelity (Tier 1): deepen memory-partition queues
# 64->256 so each of the 48 sub-partitions can hold enough outstanding requests
# to sustain its ~100 GB/s of HBM3e (the stock 64 structurally cannot, and
# starved DRAM to ~11% at high occupancy). See H200_config_fidelity.md.
-gpgpu_dram_partition_queues 256:256:256:256
-gpgpu_perf_sim_memcpy 0
-gpgpu_memory_partition_indexing 0

# 128 KB Inst. (inherited)
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:2:48,4
-gpgpu_inst_fetch_throughput 4
# 128 KB Tex (inherited)
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# 64 KB Const (inherited)
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
-gpgpu_perfect_inst_const_cache 1

# interconnection — local xbar
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_flit_size 40
-icnt_arbiter_algo 1

# memory partition latency config (v3: keep inherited values)
-gpgpu_l2_rop_latency 160
-dram_latency 100

# dram model
-gpgpu_dram_scheduler 1
# 2026-06-02 H200 memory-fidelity (Tier 1): FR-FCFS scheduler window 64->256
-gpgpu_frfcfs_dram_sched_queue_size 256
# 2026-06-02 H200 memory-fidelity (Tier 1): DRAM return queue 192->512
-gpgpu_dram_return_queue_size 512

# HBM3e — v3 topology-faithful
# 24 channels × 32 B = 6144-bit modeled bus ≈ real H200's 6-stack × 1024-bit.
-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 32
-gpgpu_dram_burst_length 2
-dram_data_command_freq_ratio 2
-gpgpu_mem_address_mask 1
# v3 §7.2: keep inherited B200 mapping; addrdec.cc has a gap modulo path for 24 channels.
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCB.CCCSSSSS

# HBM3e timings at 3125 MHz (B200 × 1.5625, rounded up per v3 §7.3).
-gpgpu_dram_timing_opt "nbk=16:CCD=4:RRD=11:RCD=44:RAS=104:RP=44:RC=147:CL=44:WL=8:CDLR=11:WR=38:nbkgrp=4:CCDL=8:RTPL=11"

# HBM dual-bus interface
-dram_dual_bus_interface 1
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

-dram_seperate_write_queue_enable 1
-dram_write_queue_size 64:56:32

# stat collection
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# deadlock detect off for long runs
-gpgpu_deadlock_detect 0

# WS_BASE reproduction override: faithful H200-style warp-specialized run.
-gpgpu_pc_pair_issue_enabled 0
-gpgpu_memlatency_stat 0
